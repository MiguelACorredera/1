// src/components/SortingBars.jsx
import React from "react";

const SortingBars = ({ array, comparing, swapping }) => {
  return (
    <div className="flex items-end justify-center h-80 space-x-1 mt-6">
      {array.map((value, idx) => {
        let color = "bg-blue-500";
        if (comparing.includes(idx)) color = "bg-yellow-400";
        if (swapping.includes(idx)) color = "bg-red-500";

        return (
          <div
            key={idx}
            className={`${color} w-2 rounded-t`}
            style={{ height: `${value * 3}px` }}
          ></div>
        );
      })}
    </div>
  );
};

export default SortingBars;

