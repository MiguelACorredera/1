⚙️ Core Logic Example — Bubble Sort (visualized)

Each algorithm returns an array of animation steps (e.g., compare, swap actions).

// src/algorithms/bubbleSort.js
export function bubbleSortAnimations(arr) {
  const animations = [];
  const array = [...arr];
  for (let i = 0; i < array.length - 1; i++) {
    for (let j = 0; j < array.length - i - 1; j++) {
      animations.push(["compare", j, j + 1]);
      if (array[j] > array[j + 1]) {
        animations.push(["swap", j, array[j + 1]]);
        animations.push(["swap", j + 1, array[j]]);
        [array[j], array[j + 1]] = [array[j + 1], array[j]];
      }
    }
  }
  return animations;
}

