  );
}

🧩 Animation Controller (React State)
// src/App.jsx
import React, { useState, useEffect } from "react";
import { bubbleSortAnimations } from "./algorithms/bubbleSort";
import SortingBars from "./components/SortingBars";
import ControlPanel from "./components/ControlPanel";

function App() {
  const [array, setArray] = useState([]);
  const [comparing, setComparing] = useState([]);
  const [swapping, setSwapping] = useState([]);
  const [speed, setSpeed] = useState(100);
  const [arraySize, setArraySize] = useState(30);

  const generateArray = () => {
    const newArr = Array.from({ length: arraySize }, () =>
      Math.floor(Math.random() * 100)
    );
    setArray(newArr);
  };

  useEffect(() => {
    generateArray();
  }, [arraySize]);

  const startSorting = async () => {
    const animations = bubbleSortAnimations(array);
    for (let i = 0; i < animations.length; i++) {
      const [action, a, b] = animations[i];
      if (action === "compare") {
        setComparing([a, b]);
      } else if (action === "swap") {
        setArray((prev) => {
          const newArr = [...prev];
          newArr[a] = b;
          return newArr;
        });
        setSwapping([a]);
      }
      await new Promise((r) => setTimeout(r, speed));
    }
    setComparing([]);
    setSwapping([]);
  };

  return (
    <div className="text-center p-4">
      <h1 className="text-3xl font-bold mb-4">Sorting Visualizer</h1>
      <ControlPanel
        handleGenerate={generateArray}
        handleSort={startSorting}
        arraySize={arraySize}
        setArraySize={setArraySize}
        speed={speed}
        setSpeed={setSpeed}
      />
      <SortingBars array={array} comparing={comparing} swapping={swapping} />
    </div>
  );
}

export default App;

